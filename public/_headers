# Cloudflare Pages Custom Headers Configuration
# Documentation: https://developers.cloudflare.com/pages/platform/headers/

# 1. Global HTML Pages: Edge Caching for SSG pages (<50ms global TTFB)
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  Cache-Control: public, max-age=0, s-maxage=604800, stale-while-revalidate=86400

# 2. Localized Open Graph Cards (/og/{lang}.png) for Social Scrapers (X, WhatsApp, LinkedIn, Facebook)
/og/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# 3. Bundled JavaScript and CSS Assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# 4. Static Images & Favicons
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable

# 5. Search Engine Sitemaps & Robots
/sitemap*
  Cache-Control: public, max-age=3600, s-maxage=86400, stale-while-revalidate=3600
/robots.txt
  Cache-Control: public, max-age=3600, s-maxage=86400
