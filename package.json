{
  "name": "antigravity-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node --max-old-space-size=4096 ./node_modules/astro/bin/astro.mjs build && node scripts/generate-tiered-sitemaps.mjs",
