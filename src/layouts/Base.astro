---
// src/layouts/Base.astro
import { LOCALES, getLocale, getLocalizedPath, DEFAULT_LOCALE } from '../i18n/config';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  canonicalPath?: string;
  jsonLd?: object | object[];
  faqs?: Array<{ q: string; a: string }>;
  lang?: string;
  noindex?: boolean;
}

const { title, description, canonical, canonicalPath, jsonLd, faqs, lang = DEFAULT_LOCALE, noindex = false } = Astro.props;

const currentLocaleConfig = getLocale(lang);
const baseUrl = 'https://nanotomicro.com';

// Current clean path without query or locale prefix
const pathname = Astro.url.pathname;
const resolvedCanonical = canonical
  ? canonical
  : canonicalPath
  ? `${baseUrl}${canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`}`
  : `${baseUrl}${getLocalizedPath(pathname, lang)}`;

// Build Hreflang Alternates (one per locale + x-default)
const hreflangAlternates = LOCALES.map((loc) => ({
  hreflang: loc.hreflang,
  href: `${baseUrl}${getLocalizedPath(pathname, loc.code)}`,
}));

const xDefaultHref = `${baseUrl}${getLocalizedPath(pathname, DEFAULT_LOCALE)}`;

// Process JSON-LD with inLanguage
const rawJsonLdArray = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const jsonLdArray = rawJsonLdArray.map((item) => ({
  ...item,
  inLanguage: currentLocaleConfig.code,
}));

if (faqs && faqs.length > 0) {
  jsonLdArray.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: currentLocaleConfig.code,
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  });
}
---

<!doctype html>
<html lang={currentLocaleConfig.hreflang} dir={currentLocaleConfig.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonical} />

    <!-- Hreflang Alternates Architecture -->
    {
      !noindex && hreflangAlternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    {
      !noindex && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    }

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:site_name" content="NanoToMicro" />
    <meta property="og:image" content={`${baseUrl}og/${currentLocaleConfig.code}.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Nano to Micro Scale Continuum (${currentLocaleConfig.name})`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${baseUrl}og/${currentLocaleConfig.code}.png`} />

    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
    <meta name="theme-color" content="#070b12" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {
      jsonLdArray.map((item) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(item)}
        />
      ))
    }

    <style>
      :root {
        --bg: #070b12;
        --panel: #0f1623;
        --text: #f8fafc;
        --muted: #e2e8f0;
        --text-dim: #cbd5e1;
        --accent: #fbbf24;
        --accent-hover: #fde68a;
        --primary: #f59e0b;
        --cyan: #38bdf8;
        --border: rgba(255, 255, 255, 0.12);
        --radius: 14px;
        --max-width: 1120px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
        line-height: 1.65;
        background-image: 
          linear-gradient(rgba(245, 158, 11, 0.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(245, 158, 11, 0.03) 1px, transparent 1px);
        background-size: 40px 40px;
        background-position: center top;
      }

      a {
        color: var(--accent);
        text-decoration: none;
        transition: color 0.15s ease, text-decoration 0.15s ease;
      }

      a:visited {
        color: var(--accent);
      }

      a:hover {
        color: var(--accent-hover);
        text-decoration: underline;
      }

      header {
        border-bottom: 1px solid var(--border);
        background: rgba(7, 11, 18, 0.9);
        backdrop-filter: blur(12px);
        position: sticky;
        top: 0;
        z-index: 100;
        padding: 12px 24px;
      }

      .nav-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .brand-logo {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 18px;
        font-weight: 900;
        color: #ffffff !important;
        text-decoration: none !important;
        letter-spacing: -0.02em;
        flex-shrink: 0;
      }

      .brand-logo:hover {
        color: var(--accent) !important;
      }

      .nav-right-wrap {
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 18px;
        font-size: 14px;
        font-weight: 600;
      }

      .nav-links a {
        color: var(--muted);
      }

      .nav-links a:hover {
        color: #ffffff;
        text-decoration: none;
      }

      .nav-badge {
        background: rgba(245, 158, 11, 0.15);
        color: #fbbf24 !important;
        padding: 4px 10px;
        border-radius: 999px;
        border: 1px solid rgba(245, 158, 11, 0.3);
      }

      main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 24px 20px 80px;
      }

      /* RTL Support Helpers */
      [dir="rtl"] {
        text-align: right;
      }

      [dir="rtl"] .brand-logo {
        margin-inline-end: auto;
      }

      /* Multi-Column Footer */
      footer {
        border-top: 1px solid var(--border);
        background: #05080e;
        padding: 60px 24px 30px;
        color: var(--muted);
        font-size: 13px;
      }

      .footer-inner {
        max-width: var(--max-width);
        margin: 0 auto;
      }

      .footer-top {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 40px;
        margin-bottom: 50px;
      }

      .footer-brand p {
        font-size: 13px;
        line-height: 1.6;
        margin-top: 10px;
        color: #cbd5e1;
      }

      .footer-links-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 30px 20px;
      }

      .footer-col h4 {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #cbd5e1;
        margin: 0 0 12px;
      }

      .footer-col ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .footer-col a {
        color: #cbd5e1;
        font-size: 12px;
        font-family: ui-monospace, monospace;
      }

      .footer-col a:hover {
        color: #fbbf24;
      }

      .footer-bottom {
        padding-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        font-size: 12px;
        color: #94a3b8;
      }

      @media (max-width: 900px) {
        .footer-top {
          grid-template-columns: 1fr;
        }
        .footer-links-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 700px) {
        .nav-links {
          display: none;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="nav-inner">
        <a href={getLocalizedPath('/', lang)} class="brand-logo">
          <span style="color: #f59e0b;">⚡</span> Nano to Micro
        </a>

        <div class="nav-right-wrap">
          <nav class="nav-links" aria-label="Main navigation">
            <a href={getLocalizedPath('/convert/nano-to-micro/', lang)}>Converters</a>
            <a href={getLocalizedPath('/si-prefix-converter/', lang)}>SI Prefixes</a>
            <a href={getLocalizedPath('/conversion-charts/', lang)}>Charts</a>
            <a href={getLocalizedPath('/antigravity/', lang)} class="nav-badge">Antigravity Hub</a>
          </nav>
          <LanguageSwitcher currentLocale={lang} currentPath={pathname} />
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-top">
          <div class="footer-brand">
            <div class="brand-logo" style="font-size: 16px;">
              <span style="color: #f59e0b;">⚡</span> Nano to Micro
            </div>
            <p>
              The definitive reference for all nano ↔ micro conversions. Every calculation is performed using exact SI metric definitions for zero floating-point drift and scientific precision.
            </p>
          </div>

          <div class="footer-links-grid">
            <!-- LENGTH -->
            <div class="footer-col">
              <h4>Length</h4>
              <ul>
                <li><a href={getLocalizedPath('/convert/nanometers-to-micrometers/', lang)}>nm ↔ µm</a></li>
                <li><a href={getLocalizedPath('/convert/nano-to-micro/', lang)}>pm ↔ nm</a></li>
                <li><a href={getLocalizedPath('/convert/micrometers-to-nanometers/', lang)}>µm ↔ mm</a></li>
                <li><a href={getLocalizedPath('/convert/nano-to-pico/', lang)}>nm ↔ pm</a></li>
                <li><a href={getLocalizedPath('/convert/pico-to-nano/', lang)}>pm ↔ µm</a></li>
                <li><a href={getLocalizedPath('/convert/meter-to-micrometer/', lang)}>µm ↔ m</a></li>
              </ul>
            </div>

            <!-- MASS -->
            <div class="footer-col">
              <h4>Mass</h4>
              <ul>
                <li><a href={getLocalizedPath('/convert/nanograms-to-micrograms/', lang)}>ng ↔ µg</a></li>
                <li><a href={getLocalizedPath('/convert/micrograms-to-nanograms/', lang)}>pg ↔ ng</a></li>
                <li><a href={getLocalizedPath('/convert/gram-to-microgram/', lang)}>µg ↔ mg</a></li>
                <li><a href={getLocalizedPath('/convert/nanograms-to-micrograms/', lang)}>ng ↔ pg</a></li>
                <li><a href={getLocalizedPath('/convert/gram-to-microgram/', lang)}>µg ↔ g</a></li>
                <li><a href={getLocalizedPath('/convert/gram-to-microgram/', lang)}>kg ↔ µg</a></li>
              </ul>
            </div>

            <!-- CONCENTRATION -->
            <div class="footer-col">
              <h4>Concentration</h4>
              <ul>
                <li><a href={getLocalizedPath('/convert/nanomolar-to-micromolar/', lang)}>nM ↔ µM</a></li>
                <li><a href={getLocalizedPath('/convert/nanomolar-to-micromolar/', lang)}>pM ↔ nM</a></li>
                <li><a href={getLocalizedPath('/convert/nanomolar-to-micromolar/', lang)}>µM ↔ mM</a></li>
                <li><a href={getLocalizedPath('/convert/nanomolar-to-micromolar/', lang)}>pM ↔ µM</a></li>
                <li><a href={getLocalizedPath('/convert/nanomolar-to-micromolar/', lang)}>µM ↔ M</a></li>
              </ul>
            </div>

            <!-- CAPACITANCE -->
            <div class="footer-col">
              <h4>Capacitance</h4>
              <ul>
                <li><a href={getLocalizedPath('/convert/nanofarads-to-microfarads/', lang)}>nF ↔ µF</a></li>
                <li><a href={getLocalizedPath('/convert/microfarads-to-nanofarads/', lang)}>pF ↔ nF</a></li>
                <li><a href={getLocalizedPath('/convert/microfarads-to-nanofarads/', lang)}>µF ↔ mF</a></li>
                <li><a href={getLocalizedPath('/convert/nanofarads-to-microfarads/', lang)}>nF ↔ pF</a></li>
                <li><a href={getLocalizedPath('/convert/microfarads-to-nanofarads/', lang)}>µF ↔ F</a></li>
              </ul>
            </div>

            <!-- TIME -->
            <div class="footer-col">
              <h4>Time</h4>
              <ul>
                <li><a href={getLocalizedPath('/convert/nanoseconds-to-microseconds/', lang)}>ns ↔ µs</a></li>
                <li><a href={getLocalizedPath('/convert/second-to-microsecond/', lang)}>ps ↔ ns</a></li>
                <li><a href={getLocalizedPath('/convert/second-to-microsecond/', lang)}>µs ↔ ms</a></li>
                <li><a href={getLocalizedPath('/convert/second-to-microsecond/', lang)}>µs ↔ s</a></li>
                <li><a href={getLocalizedPath('/convert/second-to-microsecond/', lang)}>µs ↔ min</a></li>
              </ul>
            </div>

            <!-- VOLUME -->
            <div class="footer-col">
              <h4>Volume</h4>
              <ul>
                <li><a href={getLocalizedPath('/convert/nano-to-micro/', lang)}>nL ↔ µL</a></li>
                <li><a href={getLocalizedPath('/convert/nano-to-micro/', lang)}>pL ↔ nL</a></li>
                <li><a href={getLocalizedPath('/convert/micro-to-nano/', lang)}>µL ↔ mL</a></li>
                <li><a href={getLocalizedPath('/convert/pico-to-nano/', lang)}>pL ↔ µL</a></li>
                <li><a href={getLocalizedPath('/convert/micro-to-nano/', lang)}>µL ↔ L</a></li>
              </ul>
            </div>

            <!-- FORCE & MAGNETIC -->
            <div class="footer-col">
              <h4>Force & Fields</h4>
              <ul>
                <li><a href={getLocalizedPath('/convert/newton-to-micronewton/', lang)}>N ↔ µN</a></li>
                <li><a href={getLocalizedPath('/convert/tesla-to-gauss/', lang)}>T ↔ G</a></li>
                <li><a href={getLocalizedPath('/convert/meter-to-micrometer/', lang)}>m ↔ µm</a></li>
                <li><a href={getLocalizedPath('/convert/second-to-microsecond/', lang)}>s ↔ µs</a></li>
              </ul>
            </div>

            <!-- PHYSICS HUB -->
            <div class="footer-col">
              <h4>Physics Research</h4>
              <ul>
                <li><a href={getLocalizedPath('/antigravity/', lang)}>Antigravity Hub</a></li>
                <li><a href={getLocalizedPath('/antigravity/what-is-antigravity/', lang)}>What is Antigravity</a></li>
                <li><a href={getLocalizedPath('/antigravity/gravitational-shielding/', lang)}>Gravitational Shielding</a></li>
                <li><a href={getLocalizedPath('/antigravity/antimatter-gravity/', lang)}>Antimatter Gravity</a></li>
                <li><a href={getLocalizedPath('/antigravity/negative-mass/', lang)}>Negative Mass</a></li>
                <li><a href={getLocalizedPath('/antigravity/magnetic-levitation/', lang)}>Magnetic Levitation</a></li>
              </ul>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <div>
            © {new Date().getFullYear()} Nano to Micro. All rights reserved. Precision SI conversions & peer-reviewed physical metrology.
          </div>
          <div>
            NIST & BIPM Compliant · Zero Floating-Point Drift
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
