---
// src/layouts/Base.astro

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  canonicalPath?: string;
  jsonLd?: object | object[];
}

const { title, description, canonical, canonicalPath, jsonLd } = Astro.props;

const baseUrl = 'https://nanotomicro.com';
const resolvedCanonical = canonical
  ? canonical
  : canonicalPath
  ? `${baseUrl}${canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`}`
  : `${baseUrl}/`;

const jsonLdArray = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:site_name" content="NanoToMicro" />

    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="theme-color" content="#0b0f14" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {
      jsonLdArray.map((item) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(item)}
        />
      ))
    }

    <style>
      :root {
        --bg: #070b12;
        --panel: #0f1623;
        --text: #f8fafc;
        --muted: #cbd5e1;
        --text-dim: #94a3b8;
        --accent: #fbbf24;
        --accent-hover: #fde68a;
        --primary: #f59e0b;
        --cyan: #38bdf8;
        --border: rgba(255, 255, 255, 0.1);
        --radius: 14px;
        --max-width: 1120px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
        line-height: 1.65;
        background-image: 
          linear-gradient(rgba(245, 158, 11, 0.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(245, 158, 11, 0.03) 1px, transparent 1px);
        background-size: 40px 40px;
        background-position: center top;
      }

      a {
        color: var(--accent);
        text-decoration: none;
        transition: color 0.15s ease, text-decoration 0.15s ease;
      }

      a:visited {
        color: var(--accent);
      }

      a:hover {
        color: var(--accent-hover);
        text-decoration: underline;
      }

      header {
        border-bottom: 1px solid var(--border);
        background: rgba(7, 11, 18, 0.9);
        backdrop-filter: blur(12px);
        position: sticky;
        top: 0;
        z-index: 100;
        padding: 14px 24px;
      }

      .nav-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .brand-logo {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 18px;
        font-weight: 900;
        color: #ffffff !important;
        text-decoration: none !important;
        letter-spacing: -0.02em;
      }

      .brand-logo:hover {
        color: var(--accent) !important;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 20px;
        font-size: 14px;
        font-weight: 600;
      }

      .nav-links a {
        color: var(--muted);
      }

      .nav-links a:hover {
        color: #ffffff;
        text-decoration: none;
      }

      .nav-badge {
        background: rgba(245, 158, 11, 0.15);
        color: #fbbf24 !important;
        padding: 4px 10px;
        border-radius: 999px;
        border: 1px solid rgba(245, 158, 11, 0.3);
      }

      main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 24px 20px 80px;
      }

      /* Multi-Column Footer */
      footer {
        border-top: 1px solid var(--border);
        background: #05080e;
        padding: 60px 24px 30px;
        color: var(--muted);
        font-size: 13px;
      }

      .footer-inner {
        max-width: var(--max-width);
        margin: 0 auto;
      }

      .footer-top {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 40px;
        margin-bottom: 50px;
      }

      .footer-brand p {
        font-size: 13px;
        line-height: 1.6;
        margin-top: 10px;
        color: #64748b;
      }

      .footer-links-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 30px 20px;
      }

      .footer-col h4 {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #cbd5e1;
        margin: 0 0 12px;
      }

      .footer-col ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .footer-col a {
        color: #64748b;
        font-size: 12px;
        font-family: ui-monospace, monospace;
      }

      .footer-col a:hover {
        color: #fbbf24;
      }

      .footer-bottom {
        padding-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        font-size: 12px;
        color: #475569;
      }

      @media (max-width: 900px) {
        .footer-top {
          grid-template-columns: 1fr;
        }
        .footer-links-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 600px) {
        .nav-links {
          gap: 12px;
          font-size: 13px;
        }
        .footer-links-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>

  <body>
    <header>
      <div class="nav-inner">
        <a href="/" class="brand-logo">
          <span style="color: #f59e0b;">⚡</span> Nano to Micro
        </a>
        <nav class="nav-links" aria-label="Main navigation">
          <a href="/convert/nano-to-micro/">Converters</a>
          <a href="/si-prefix-converter/">SI Prefixes</a>
          <a href="/conversion-charts/">Charts</a>
          <a href="/antigravity/" class="nav-badge">Antigravity Hub</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-top">
          <div class="footer-brand">
            <div class="brand-logo" style="font-size: 16px;">
              <span style="color: #f59e0b;">⚡</span> Nano to Micro
            </div>
            <p>
              The definitive reference for all nano ↔ micro conversions. Every calculation is performed using exact SI metric definitions for zero floating-point drift and scientific precision.
            </p>
          </div>

          <div class="footer-links-grid">
            <!-- LENGTH -->
            <div class="footer-col">
              <h4>Length</h4>
              <ul>
                <li><a href="/convert/nanometers-to-micrometers/">nm ↔ µm</a></li>
                <li><a href="/convert/nano-to-micro/">pm ↔ nm</a></li>
                <li><a href="/convert/micrometers-to-nanometers/">µm ↔ mm</a></li>
                <li><a href="/convert/nano-to-pico/">nm ↔ pm</a></li>
                <li><a href="/convert/pico-to-nano/">pm ↔ µm</a></li>
                <li><a href="/convert/meter-to-micrometer/">µm ↔ m</a></li>
              </ul>
            </div>

            <!-- MASS -->
            <div class="footer-col">
              <h4>Mass</h4>
              <ul>
                <li><a href="/convert/nanograms-to-micrograms/">ng ↔ µg</a></li>
                <li><a href="/convert/micrograms-to-nanograms/">pg ↔ ng</a></li>
                <li><a href="/convert/gram-to-microgram/">µg ↔ mg</a></li>
                <li><a href="/convert/nanograms-to-micrograms/">ng ↔ pg</a></li>
                <li><a href="/convert/gram-to-microgram/">µg ↔ g</a></li>
                <li><a href="/convert/gram-to-microgram/">kg ↔ µg</a></li>
              </ul>
            </div>

            <!-- CONCENTRATION -->
            <div class="footer-col">
              <h4>Concentration</h4>
              <ul>
                <li><a href="/convert/nanomolar-to-micromolar/">nM ↔ µM</a></li>
                <li><a href="/convert/nanomolar-to-micromolar/">pM ↔ nM</a></li>
                <li><a href="/convert/nanomolar-to-micromolar/">µM ↔ mM</a></li>
                <li><a href="/convert/nanomolar-to-micromolar/">pM ↔ µM</a></li>
                <li><a href="/convert/nanomolar-to-micromolar/">µM ↔ M</a></li>
              </ul>
            </div>

            <!-- CAPACITANCE -->
            <div class="footer-col">
              <h4>Capacitance</h4>
              <ul>
                <li><a href="/convert/nanofarads-to-microfarads/">nF ↔ µF</a></li>
                <li><a href="/convert/microfarads-to-nanofarads/">pF ↔ nF</a></li>
                <li><a href="/convert/microfarads-to-nanofarads/">µF ↔ mF</a></li>
                <li><a href="/convert/nanofarads-to-microfarads/">nF ↔ pF</a></li>
                <li><a href="/convert/microfarads-to-nanofarads/">µF ↔ F</a></li>
              </ul>
            </div>

            <!-- TIME -->
            <div class="footer-col">
              <h4>Time</h4>
              <ul>
                <li><a href="/convert/nanoseconds-to-microseconds/">ns ↔ µs</a></li>
                <li><a href="/convert/second-to-microsecond/">ps ↔ ns</a></li>
                <li><a href="/convert/second-to-microsecond/">µs ↔ ms</a></li>
                <li><a href="/convert/second-to-microsecond/">µs ↔ s</a></li>
                <li><a href="/convert/second-to-microsecond/">µs ↔ min</a></li>
              </ul>
            </div>

            <!-- VOLUME -->
            <div class="footer-col">
              <h4>Volume</h4>
              <ul>
                <li><a href="/convert/nano-to-micro/">nL ↔ µL</a></li>
                <li><a href="/convert/nano-to-micro/">pL ↔ nL</a></li>
                <li><a href="/convert/micro-to-nano/">µL ↔ mL</a></li>
                <li><a href="/convert/pico-to-nano/">pL ↔ µL</a></li>
                <li><a href="/convert/micro-to-nano/">µL ↔ L</a></li>
              </ul>
            </div>

            <!-- FORCE & MAGNETIC -->
            <div class="footer-col">
              <h4>Force & Fields</h4>
              <ul>
                <li><a href="/convert/newton-to-micronewton/">N ↔ µN</a></li>
                <li><a href="/convert/tesla-to-gauss/">T ↔ G</a></li>
                <li><a href="/convert/meter-to-micrometer/">m ↔ µm</a></li>
                <li><a href="/convert/second-to-microsecond/">s ↔ µs</a></li>
              </ul>
            </div>

            <!-- PHYSICS HUB -->
            <div class="footer-col">
              <h4>Physics Research</h4>
              <ul>
                <li><a href="/antigravity/">Antigravity Hub</a></li>
                <li><a href="/antigravity/what-is-antigravity/">What is Antigravity</a></li>
                <li><a href="/antigravity/gravitational-shielding/">Gravitational Shielding</a></li>
                <li><a href="/antigravity/antimatter-gravity/">Antimatter Gravity</a></li>
                <li><a href="/antigravity/negative-mass/">Negative Mass</a></li>
                <li><a href="/antigravity/magnetic-levitation/">Magnetic Levitation</a></li>
              </ul>
            </div>
          </div>
        </div>

        <div class="footer-bottom">
          <div>
            © {new Date().getFullYear()} Nano to Micro. All rights reserved. Precision SI conversions & peer-reviewed physical metrology.
          </div>
          <div>
            NIST & BIPM Compliant · Zero Floating-Point Drift
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
