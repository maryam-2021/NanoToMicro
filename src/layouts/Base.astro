---
// src/layouts/Base.astro
import { LOCALES, getLocale, getLocalizedPath, DEFAULT_LOCALE, localePath } from '../i18n/config';
import { t } from '../i18n/utils';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  canonicalPath?: string;
  jsonLd?: object | object[];
  faqs?: Array<{ q: string; a: string }>;
  lang?: string;
  noindex?: boolean;
}

const { title, description, canonical, canonicalPath, jsonLd, faqs, lang = DEFAULT_LOCALE, noindex = false } = Astro.props;

const currentLocaleConfig = getLocale(lang);
const baseUrl = 'https://nanotomicro.com';

// Current clean path without query or locale prefix
const pathname = Astro.url.pathname;
const resolvedCanonical = canonical
  ? canonical
  : canonicalPath
  ? `${baseUrl}${canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`}`
  : `${baseUrl}${getLocalizedPath(pathname, lang)}`;

// Breadcrumb generation for all pages
const isHome = pathname === '/' || pathname === `/${lang}/` || pathname === `/${lang}`;
const cleanSegments = pathname.replace(new RegExp(`^/${lang}(/|$)`), '/').split('/').filter(Boolean);

const breadcrumbs = !isHome ? [
  { name: 'Home', url: localePath(lang, '/') },
  ...cleanSegments.map((segment, idx) => {
    const isLast = idx === cleanSegments.length - 1;
    let url = '/' + cleanSegments.slice(0, idx + 1).join('/') + '/';
    let name = segment.replace(/-/g, ' ');
    name = name.charAt(0).toUpperCase() + name.slice(1);
    if (segment === 'convert') {
      name = 'Converters';
      url = '/converters/';
    }
    if (segment === 'converters') name = 'Converters';
    if (segment === 'guides') name = 'Guides';
    if (segment === 'physics') name = 'Physics Hub';
    return { name, url, isLast };
  })
] : [];

// Build Hreflang Alternates (one per locale + x-default)
const hreflangAlternates = LOCALES.map((loc) => ({
  hreflang: loc.hreflang,
  href: `${baseUrl}${getLocalizedPath(pathname, loc.code)}`,
}));

const xDefaultHref = `${baseUrl}${getLocalizedPath(pathname, DEFAULT_LOCALE)}`;

// Process JSON-LD with inLanguage
const rawJsonLdArray = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const jsonLdArray = rawJsonLdArray.map((item) => ({
  ...item,
  inLanguage: currentLocaleConfig.code,
}));

if (faqs && faqs.length > 0) {
  jsonLdArray.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    inLanguage: currentLocaleConfig.code,
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.a,
      },
    })),
  });
}
---

<!doctype html>
<html lang={currentLocaleConfig.hreflang} dir={currentLocaleConfig.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={resolvedCanonical} />

    <!-- Hreflang Alternates Architecture -->
    {
      !noindex && hreflangAlternates.map((alt) => (
        <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
      ))
    }
    {
      !noindex && <link rel="alternate" hreflang="x-default" href={xDefaultHref} />
    }

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:site_name" content="NanoToMicro" />
    <meta property="og:image" content={`${baseUrl}og/${currentLocaleConfig.code}.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Nano to Micro Scale Continuum (${currentLocaleConfig.name})`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${baseUrl}og/${currentLocaleConfig.code}.png`} />

    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large"} />
    <meta name="theme-color" content="#070b12" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts CDN -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet" />

    {
      jsonLdArray.map((item) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(item)}
        />
      ))
    }

    <style>
      :root {
        --bg: #070b12;
        --panel: #0f1623;
        --text: #f8fafc;
        --muted: #e2e8f0;
        --text-dim: #cbd5e1;
        --accent: #fbbf24;
        --accent-hover: #fde68a;
        --primary: #f59e0b;
        --cyan: #38bdf8;
        --border: rgba(255, 255, 255, 0.12);
        --radius: 14px;
        --max-width: 1120px;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
        line-height: 1.65;
        background-image: 
          linear-gradient(rgba(245, 158, 11, 0.03) 1px, transparent 1px),
          linear-gradient(90deg, rgba(245, 158, 11, 0.03) 1px, transparent 1px);
        background-size: 40px 40px;
        background-position: center top;
      }

      a {
        color: var(--accent);
        text-decoration: none;
        transition: color 0.15s ease, text-decoration 0.15s ease;
      }

      a:visited {
        color: var(--accent);
      }

      a:hover {
        color: var(--accent-hover);
        text-decoration: underline;
      }

      header {
        border-bottom: 1px solid var(--border);
        background: rgba(7, 11, 18, 0.9);
        backdrop-filter: blur(12px);
        position: sticky;
        top: 0;
        z-index: 100;
        padding: 12px 24px;
      }

      .nav-inner {
        max-width: var(--max-width);
        margin: 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }

      .brand-logo {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 18px;
        font-weight: 900;
        color: #ffffff !important;
        text-decoration: none !important;
        letter-spacing: -0.02em;
        flex-shrink: 0;
      }

      .brand-logo:hover {
        color: var(--accent) !important;
      }

      .nav-right-wrap {
        display: flex;
        align-items: center;
        gap: 16px;
      }

      .nav-links {
        display: flex;
        align-items: center;
        gap: 18px;
        font-size: 14px;
        font-weight: 600;
      }

      .nav-links a {
        color: var(--muted);
      }

      .nav-links a:hover {
        color: #ffffff;
        text-decoration: none;
      }

      /* Navigation Dropdown */
      .nav-dropdown {
        position: relative;
        display: inline-flex;
        align-items: center;
      }

      .dropdown-toggle {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        color: var(--muted);
        background: transparent;
        border: none;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        padding: 6px 0;
        font-family: inherit;
      }

      .dropdown-toggle:hover {
        color: #38bdf8;
      }

      .dropdown-menu {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        min-width: 270px;
        background: #0f1623;
        border: 1px solid rgba(79, 195, 247, 0.3);
        border-radius: 12px;
        box-shadow: 0 16px 36px rgba(0, 0, 0, 0.7);
        padding: 8px 0;
        z-index: 250;
      }

      .nav-dropdown:hover .dropdown-menu,
      .nav-dropdown:focus-within .dropdown-menu {
        display: block;
      }

      .dropdown-menu a {
        display: block;
        padding: 8px 16px;
        color: #cbd5e1 !important;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none !important;
        transition: all 0.15s ease;
      }

      .dropdown-menu a:hover {
        background: rgba(56, 189, 248, 0.12);
        color: #38bdf8 !important;
        padding-left: 20px;
      }

      .dropdown-divider {
        height: 1px;
        background: rgba(255, 255, 255, 0.08);
        margin: 6px 0;
      }

      .nav-badge {
        background: rgba(245, 158, 11, 0.15);
        color: #fbbf24 !important;
        padding: 4px 10px;
        border-radius: 999px;
        border: 1px solid rgba(245, 158, 11, 0.3);
      }

      /* Breadcrumb Styles */
      .breadcrumb-nav {
        margin-bottom: 20px;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      .breadcrumb {
        display: flex;
        list-style: none;
        padding: 0;
        margin: 0;
        font-size: 0.9rem;
        flex-wrap: wrap;
        gap: 5px;
        align-items: center;
      }

      .breadcrumb-item a {
        color: #38bdf8;
        text-decoration: none;
        transition: color 0.2s;
      }

      .breadcrumb-item a:hover {
        color: #fbbf24;
        text-decoration: underline;
      }

      .breadcrumb-item.active {
        color: #cbd5e1;
        font-weight: 500;
      }

      main {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 24px 20px 80px;
      }

      /* RTL Support Helpers */
      [dir="rtl"] {
        text-align: right;
      }

      [dir="rtl"] .brand-logo {
        margin-inline-end: auto;
      }

      /* Multi-Column Footer */
      footer {
        border-top: 1px solid var(--border);
        background: #05080e;
        padding: 60px 24px 30px;
        color: var(--muted);
        font-size: 13px;
      }

      .footer-inner {
        max-width: var(--max-width);
        margin: 0 auto;
      }

      .footer-top {
        display: grid;
        grid-template-columns: 280px 1fr;
        gap: 40px;
        margin-bottom: 50px;
      }

      .footer-brand p {
        font-size: 13px;
        line-height: 1.6;
        margin-top: 10px;
        color: #cbd5e1;
      }

      .footer-links-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 30px 20px;
      }

      .footer-col h4 {
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: #cbd5e1;
        margin: 0 0 12px;
      }

      .footer-col ul {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
      }

      .footer-col a {
        color: #cbd5e1;
        font-size: 12px;
        font-family: ui-monospace, monospace;
      }

      .footer-col a:hover {
        color: #fbbf24;
      }

      .footer-bottom {
        padding-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.08);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        font-size: 12px;
        color: #94a3b8;
      }

      .mobile-menu-toggle {
        display: none;
        background: rgba(255, 255, 255, 0.08);
        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 8px;
        padding: 8px;
        cursor: pointer;
        flex-direction: column;
        gap: 4px;
        width: 38px;
        height: 38px;
        justify-content: center;
        align-items: center;
      }

      .mobile-menu-toggle span {
        display: block;
        width: 20px;
        height: 2px;
        background: #ffffff;
        border-radius: 2px;
        transition: all 0.2s ease;
      }

      @media (max-width: 900px) {
        .footer-top {
          grid-template-columns: 1fr;
        }
        .footer-links-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (max-width: 768px) {
        header {
          padding: 10px 16px;
        }
        .mobile-menu-toggle {
          display: flex;
        }
        .nav-links {
          display: none;
          position: absolute;
          top: 100%;
          left: 0;
          right: 0;
          background: #0b111c;
          border-bottom: 1px solid rgba(255, 255, 255, 0.15);
          flex-direction: column;
          align-items: stretch;
          padding: 16px 20px;
          gap: 10px;
          box-shadow: 0 16px 32px rgba(0, 0, 0, 0.7);
          z-index: 150;
        }
        .nav-links.is-open {
          display: flex;
        }
        .nav-links a {
          padding: 10px 14px;
          border-radius: 8px;
          background: rgba(255, 255, 255, 0.04);
          font-size: 14px;
          display: block;
        }
        .breadcrumb {
          font-size: 0.8rem;
        }
        .breadcrumb-item + .breadcrumb-item::before {
          margin: 0 4px;
        }
        main {
          padding: 16px 14px 60px;
        }
      }
    </style>
  </head>

  <body>
    <div class="progress-bar" id="readingProgress" style="height: 3px; background: linear-gradient(90deg, #4fc3f7, #1a1a2e); position: fixed; top: 0; left: 0; width: 0%; z-index: 1000;"></div>

    <script>
      window.addEventListener('scroll', function() {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
        const bar = document.getElementById('readingProgress');
        if (bar) bar.style.width = progress + '%';
      });
    </script>

    <header>
      <div class="nav-inner">
        <a href={localePath(lang, '/')} class="brand-logo">
          <span style="color: #f59e0b;">⚡</span> {t('nav.brand', undefined, lang)}
        </a>

        <div class="nav-right-wrap">
          <nav class="nav-links" aria-label="Main navigation">
            <div class="nav-dropdown">
              <button class="dropdown-toggle" aria-haspopup="true" aria-expanded="false">
                Converters <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </button>
              <div class="dropdown-menu">
                <a href="/converters/"><strong>All Converters Hub</strong></a>
                <div class="dropdown-divider"></div>
                <a href="/converters/nanometers-to-micrometers.html">Nanometers to Micrometers (nm → µm)</a>
                <a href="/converters/nanograms-to-micrograms.html">Nanograms to Micrograms (ng → µg)</a>
                <a href="/converters/nanoseconds-to-microseconds.html">Nanoseconds to Microseconds (ns → µs)</a>
                <a href="/converters/nanofarads-to-microfarads.html">Nanofarads to Microfarads (nF → µF)</a>
                <a href="/converters/nanoamperes-to-microamperes.html">Nanoamperes to Microamperes (nA → µA)</a>
                <a href="/converters/nanovolts-to-microvolts.html">Nanovolts to Microvolts (nV → µV)</a>
                <a href="/converters/nanoliters-to-microliters.html">Nanoliters to Microliters (nL → µL)</a>
                <a href="/converters/nanocoulombs-to-microcoulombs.html">Nanocoulombs to Microcoulombs (nC → µC)</a>
                <a href="/converters/micro-to-nano.html">Micro to Nano (µ → n)</a>
              </div>
            </div>
            <a href={localePath(lang, '/si-prefix-converter/')}>{t('nav.siPrefixes', undefined, lang)}</a>
            <a href={localePath(lang, '/conversion-charts/')}>{t('nav.charts', undefined, lang)}</a>
            <a href="/physics/" class="nav-badge">Physics Hub</a>
          </nav>
          <LanguageSwitcher currentLocale={lang} currentPath={pathname} />
          <button class="mobile-menu-toggle" aria-label="Toggle menu" onclick="document.querySelector('.nav-links').classList.toggle('is-open')">
            <span></span><span></span><span></span>
          </button>
        </div>
      </div>
    </header>

    <main>
      {breadcrumbs.length > 0 && (
        <nav aria-label="Breadcrumb" class="breadcrumb-nav">
          <ol class="breadcrumb" style="display: flex; list-style: none; padding: 0; margin: 0 0 20px 0; font-size: 0.9rem; flex-wrap: wrap; gap: 5px; align-items: center;">
            {breadcrumbs.map((crumb, idx) => (
              <>
                {idx > 0 && <li class="breadcrumb-item" style="color: #94a3b8; user-select: none;">›</li>}
                <li class={`breadcrumb-item ${crumb.isLast ? 'active' : ''}`} style={crumb.isLast ? 'color: #cbd5e1; font-weight: 500;' : ''} {...(crumb.isLast ? { 'aria-current': 'page' } : {})}>
                  {crumb.isLast ? (
                    crumb.name
                  ) : (
                    <a href={crumb.url} style="color: #38bdf8; text-decoration: none;">
                      {crumb.name}
                    </a>
                  )}
                </li>
              </>
            ))}
          </ol>
        </nav>
      )}
      <slot />
    </main>

    <footer>
      <div class="footer-inner">
        <div class="footer-top">
          <div class="footer-brand">
            <div class="brand-logo" style="font-size: 16px;">
              <span style="color: #f59e0b;">⚡</span> {t('nav.brand', undefined, lang)}
            </div>
            <p>
              {t('footer.tagline', undefined, lang)}
            </p>
          </div>

          <div class="footer-links-grid">
            <!-- LENGTH -->
            <div class="footer-col">
              <h4>{t('categories.length', undefined, lang)}</h4>
              <ul>
                <li><a href={localePath(lang, '/convert/nanometers-to-micrometers/')}>nm ↔ µm</a></li>
                <li><a href={localePath(lang, '/convert/nano-to-micro/')}>pm ↔ nm</a></li>
                <li><a href={localePath(lang, '/convert/micrometers-to-nanometers/')}>µm ↔ mm</a></li>
                <li><a href={localePath(lang, '/convert/nano-to-pico/')}>nm ↔ pm</a></li>
                <li><a href={localePath(lang, '/convert/pico-to-nano/')}>pm ↔ µm</a></li>
                <li><a href={localePath(lang, '/convert/meter-to-micrometer/')}>µm ↔ m</a></li>
              </ul>
            </div>

            <!-- MASS -->
            <div class="footer-col">
              <h4>{t('categories.mass', undefined, lang)}</h4>
              <ul>
                <li><a href={localePath(lang, '/convert/nanograms-to-micrograms/')}>ng ↔ µg</a></li>
                <li><a href={localePath(lang, '/convert/micrograms-to-nanograms/')}>pg ↔ ng</a></li>
                <li><a href={localePath(lang, '/convert/gram-to-microgram/')}>µg ↔ mg</a></li>
                <li><a href={localePath(lang, '/convert/nanograms-to-micrograms/')}>ng ↔ pg</a></li>
                <li><a href={localePath(lang, '/convert/gram-to-microgram/')}>µg ↔ g</a></li>
                <li><a href={localePath(lang, '/convert/gram-to-microgram/')}>kg ↔ µg</a></li>
              </ul>
            </div>

            <!-- CONCENTRATION -->
            <div class="footer-col">
              <h4>{t('categories.concentration', undefined, lang)}</h4>
              <ul>
                <li><a href={localePath(lang, '/convert/nanomolar-to-micromolar/')}>nM ↔ µM</a></li>
                <li><a href={localePath(lang, '/convert/nanomolar-to-micromolar/')}>pM ↔ nM</a></li>
                <li><a href={localePath(lang, '/convert/nanomolar-to-micromolar/')}>µM ↔ mM</a></li>
                <li><a href={localePath(lang, '/convert/nanomolar-to-micromolar/')}>pM ↔ µM</a></li>
                <li><a href={localePath(lang, '/convert/nanomolar-to-micromolar/')}>µM ↔ M</a></li>
              </ul>
            </div>

            <!-- CAPACITANCE -->
            <div class="footer-col">
              <h4>{t('categories.capacitance', undefined, lang)}</h4>
              <ul>
                <li><a href={localePath(lang, '/convert/nanofarads-to-microfarads/')}>nF ↔ µF</a></li>
                <li><a href={localePath(lang, '/convert/microfarads-to-nanofarads/')}>pF ↔ nF</a></li>
                <li><a href={localePath(lang, '/convert/microfarads-to-nanofarads/')}>µF ↔ mF</a></li>
                <li><a href={localePath(lang, '/convert/nanofarads-to-microfarads/')}>nF ↔ pF</a></li>
                <li><a href={localePath(lang, '/convert/microfarads-to-nanofarads/')}>µF ↔ F</a></li>
              </ul>
            </div>

            <!-- TIME -->
            <div class="footer-col">
              <h4>{t('categories.time', undefined, lang)}</h4>
              <ul>
                <li><a href={localePath(lang, '/convert/nanoseconds-to-microseconds/')}>ns ↔ µs</a></li>
                <li><a href={localePath(lang, '/convert/second-to-microsecond/')}>ps ↔ ns</a></li>
                <li><a href={localePath(lang, '/convert/second-to-microsecond/')}>µs ↔ ms</a></li>
                <li><a href={localePath(lang, '/convert/second-to-microsecond/')}>µs ↔ s</a></li>
                <li><a href={localePath(lang, '/convert/second-to-microsecond/')}>µs ↔ min</a></li>
              </ul>
            </div>

            <!-- VOLUME -->
            <div class="footer-col">
              <h4>{t('categories.volume', undefined, lang)}</h4>
              <ul>
                <li><a href={localePath(lang, '/convert/nano-to-micro/')}>nL ↔ µL</a></li>
                <li><a href={localePath(lang, '/convert/nano-to-micro/')}>pL ↔ nL</a></li>
                <li><a href={localePath(lang, '/convert/micro-to-nano/')}>µL ↔ mL</a></li>
                <li><a href={localePath(lang, '/convert/pico-to-nano/')}>pL ↔ µL</a></li>
                <li><a href={localePath(lang, '/convert/micro-to-nano/')}>µL ↔ L</a></li>
              </ul>
            </div>

            <!-- FORCE & MAGNETIC -->
            <div class="footer-col">
              <h4>{t('categories.forceAndFields', undefined, lang)}</h4>
              <ul>
                <li><a href={localePath(lang, '/convert/newton-to-micronewton/')}>N ↔ µN</a></li>
                <li><a href={localePath(lang, '/convert/tesla-to-gauss/')}>T ↔ G</a></li>
                <li><a href={localePath(lang, '/convert/meter-to-micrometer/')}>m ↔ µm</a></li>
                <li><a href={localePath(lang, '/convert/second-to-microsecond/')}>s ↔ µs</a></li>
              </ul>
            </div>

            <!-- PHYSICS HUB -->
            <div class="footer-col">
