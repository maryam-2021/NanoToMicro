---
// src/pages/404.astro
import Base from '../layouts/Base.astro';
import { t } from '../i18n/utils';

const lang = 'en';
---

<Base
  title="404 - Metric Coordinate Not Found | NanoToMicro"
  description={t('errorPage.desc', undefined, lang)}
  canonicalPath="/"
  noindex={true}
  lang={lang}
>
  <div class="error-container">
    <div class="error-badge">{t('errorPage.badge', undefined, lang)}</div>
    <h1 class="error-title">{t('errorPage.title', undefined, lang)}</h1>
    <p class="error-desc">
      {t('errorPage.desc', undefined, lang)}
    </p>

    <div class="scale-visual" dir="ltr">
      <div class="scale-tick">10<sup>-12</sup> (pico)</div>
      <div class="scale-arrow">⇢</div>
      <div class="scale-tick active">10<sup>-9</sup> (nano)</div>
      <div class="scale-arrow">⇢</div>
      <div class="scale-tick">10<sup>-6</sup> (micro)</div>
    </div>

    <div class="error-actions">
      <a href="/" class="btn-primary">{t('errorPage.returnHome', undefined, lang)}</a>
      <a href="/convert/nano-to-micro/" class="btn-secondary">{t('errorPage.converterBtn', undefined, lang)}</a>
      <a href="/antigravity/" class="btn-secondary">{t('errorPage.physicsBtn', undefined, lang)}</a>
    </div>
  </div>
</Base>

<style>
  .error-container {
    max-width: 680px;
    margin: 60px auto 100px;
    text-align: center;
    padding: 48px 24px;
    background: #0f1623;
    border: 1px solid rgba(245, 158, 11, 0.25);
    border-radius: 20px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
  }

  .error-badge {
    display: inline-block;
    background: rgba(239, 68, 68, 0.15);
    color: #f87171;
    border: 1px solid rgba(239, 68, 68, 0.35);
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 6px 16px;
    border-radius: 999px;
    margin-bottom: 20px;
  }

  .error-title {
    font-size: 38px;
    font-weight: 900;
    color: #ffffff;
    margin: 0 0 16px;
    line-height: 1.2;
  }

  .error-desc {
    font-size: 16px;
    color: #cbd5e1;
    line-height: 1.6;
    margin: 0 auto 32px;
    max-width: 520px;
  }

  .scale-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 16px 20px;
    margin: 0 auto 36px;
    max-width: 460px;
    font-family: ui-monospace, monospace;
    font-size: 13px;
  }

  .scale-tick {
    color: #94a3b8;
  }

  .scale-tick.active {
    color: #fbbf24;
    font-weight: 800;
  }

  .scale-arrow {
    color: #64748b;
  }

  .error-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  .btn-primary {
    background: #f59e0b;
    color: #0b0f19;
    font-weight: 800;
    padding: 12px 24px;
    border-radius: 10px;
    text-decoration: none;
    transition: background 0.2s;
  }

  .btn-primary:hover {
    background: #d97706;
  }

  .btn-secondary {
    background: rgba(255, 255, 255, 0.06);
    color: #f8fafc;
    font-weight: 600;
    padding: 12px 20px;
    border-radius: 10px;
    text-decoration: none;
    border: 1px solid rgba(255, 255, 255, 0.12);
    transition: all 0.2s;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.2);
  }
</style>
