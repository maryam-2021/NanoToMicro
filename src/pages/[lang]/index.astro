---
// src/pages/[lang]/index.astro
import Base from '../../layouts/Base.astro';
import ConverterIsland from '../../components/ConverterIsland.svelte';
import { NON_DEFAULT_LOCALES } from '../../i18n/config';
import { t } from '../../i18n/utils';

export function getStaticPaths() {
  return NON_DEFAULT_LOCALES.map((loc) => ({
    params: { lang: loc.code },
  }));
}

const { lang } = Astro.params;

const homeFaqs = [
  {
    q: t('faq.q1', undefined, lang),
    a: t('faq.a1', undefined, lang),
  },
  {
    q: t('faq.q2', undefined, lang),
    a: t('faq.a2', undefined, lang),
  },
  {
    q: t('faq.q3', undefined, lang),
    a: t('faq.a3', undefined, lang),
  },
  {
    q: t('faq.q4', undefined, lang),
    a: t('faq.a4', undefined, lang),
  },
  {
    q: t('faq.q5', undefined, lang),
    a: t('faq.a5', undefined, lang),
  },
  {
    q: t('faq.q6', undefined, lang),
    a: t('faq.a6', undefined, lang),
  },
  {
    q: t('faq.q7', undefined, lang),
    a: t('faq.a7', undefined, lang),
  },
];

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: t('meta.siteName', undefined, lang),
  url: `https://nanotomicro.com/${lang}/`,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
  },
  description: t('meta.homeDescription', undefined, lang),
};

const title = t('meta.homeTitle', undefined, lang);
const description = t('meta.homeDescription', undefined, lang);
---

<Base
  title={title}
  description={description}
  lang={lang}
  canonicalPath={`/${lang}/`}
  jsonLd={[webAppSchema]}
  faqs={homeFaqs}
>
  <!-- Slim Sticky Jump Navigation Bar -->
  <div class="sticky-nav-wrapper">
    <nav class="sticky-nav-bar" aria-label="Quick jump section navigation">
      <a href="#converters" class="nav-chip">{t('stickyNav.converters', undefined, lang)}</a>
      <span class="nav-sep">·</span>
      <a href="#formula" class="nav-chip">{t('stickyNav.formula', undefined, lang)}</a>
      <span class="nav-sep">·</span>
      <a href="#si-ladder" class="nav-chip">{t('stickyNav.siLadder', undefined, lang)}</a>
      <span class="nav-sep">·</span>
      <a href="#scale-diagram" class="nav-chip">{t('stickyNav.scale', undefined, lang)}</a>
      <span class="nav-sep">·</span>
      <a href="#antigravity" class="nav-chip">{t('stickyNav.antigravity', undefined, lang)}</a>
      <span class="nav-sep">·</span>
      <a href="#faq" class="nav-chip">{t('stickyNav.faq', undefined, lang)}</a>
    </nav>
  </div>

  <!-- Hero Section -->
  <section class="hero-container">
    <div class="hero-badge">
      <span class="pulse-dot"></span>
      <span>{t('hero.badge', undefined, lang)}</span>
    </div>

    <h1 class="main-title">
      {t('hero.titleMain', undefined, lang)} <span class="gold-gradient">{t('hero.titleAccent', undefined, lang)}</span>
    </h1>

    <p class="hero-desc">
      {t('hero.description', undefined, lang)}
    </p>

    <!-- Svelte Reactive Interactive Calculator -->
    <div class="calc-wrapper">
      <ConverterIsland
        client:load
        fromSymbol="nm"
        toSymbol="µm"
        fromName="nanometer"
        toName="micrometer"
        factor={0.001}
        exampleInput={2500}
        locale={lang}
      />
    </div>
  </section>

  <!-- Section 2: Every Nano <-> Micro Conversion -->
  <section id="converters" class="content-section">
    <div class="section-title-wrap">
      <h2>{t('categories.sectionTitle', undefined, lang)}</h2>
      <p class="section-subtitle">
        {t('categories.sectionSubtitle', undefined, lang)}
      </p>
    </div>

    <div class="category-cards-grid">
      <!-- 1. Length -->
      <div class="unit-cat-card card-length">
        <div class="cat-header">
          <div class="cat-icon icon-cyan">📏</div>
          <div>
            <h3 class="cat-title">{t('categories.length', undefined, lang)}</h3>
            <span class="cat-count">{t('categories.conversionsCount', { count: 8 }, lang)}</span>
          </div>
        </div>
        <div class="pill-grid">
          <a href={`/${lang}/convert/nanometers-to-micrometers/`} class="unit-pill pill-cyan">nm ↔ µm</a>
          <a href={`/${lang}/convert/nano-to-micro/`} class="unit-pill pill-cyan">pm ↔ nm</a>
          <a href={`/${lang}/convert/micrometers-to-nanometers/`} class="unit-pill pill-cyan">µm ↔ mm</a>
          <a href={`/${lang}/convert/nano-to-pico/`} class="unit-pill pill-cyan">nm ↔ pm</a>
          <a href={`/${lang}/convert/pico-to-nano/`} class="unit-pill pill-cyan">pm ↔ µm</a>
          <a href={`/${lang}/convert/meter-to-micrometer/`} class="unit-pill pill-cyan">µm ↔ m</a>
          <a href={`/${lang}/conversion-charts/`} class="unit-pill pill-cyan">km ↔ µm</a>
          <a href={`/${lang}/convert/micrometers-to-nanometers/`} class="unit-pill pill-cyan">µm ↔ nm</a>
        </div>
      </div>

      <!-- 2. Mass -->
      <div class="unit-cat-card card-mass">
        <div class="cat-header">
          <div class="cat-icon icon-amber">⚖️</div>
          <div>
            <h3 class="cat-title">{t('categories.mass', undefined, lang)}</h3>
            <span class="cat-count">{t('categories.conversionsCount', { count: 8 }, lang)}</span>
          </div>
        </div>
        <div class="pill-grid">
          <a href={`/${lang}/convert/nanograms-to-micrograms/`} class="unit-pill pill-amber">ng ↔ µg</a>
          <a href={`/${lang}/convert/micrograms-to-nanograms/`} class="unit-pill pill-amber">pg ↔ ng</a>
          <a href={`/${lang}/convert/gram-to-microgram/`} class="unit-pill pill-amber">µg ↔ mg</a>
          <a href={`/${lang}/convert/nanograms-to-micrograms/`} class="unit-pill pill-amber">ng ↔ pg</a>
          <a href={`/${lang}/convert/nano-to-micro/`} class="unit-pill pill-amber">pg ↔ µg</a>
          <a href={`/${lang}/convert/gram-to-microgram/`} class="unit-pill pill-amber">µg ↔ g</a>
          <a href={`/${lang}/convert/gram-to-microgram/`} class="unit-pill pill-amber">kg ↔ µg</a>
          <a href={`/${lang}/convert/micrograms-to-nanograms/`} class="unit-pill pill-amber">µg ↔ ng</a>
        </div>
      </div>

      <!-- 3. Concentration -->
      <div class="unit-cat-card card-concentration">
        <div class="cat-header">
          <div class="cat-icon icon-emerald">🧪</div>
          <div>
            <h3 class="cat-title">{t('categories.concentration', undefined, lang)}</h3>
            <span class="cat-count">{t('categories.conversionsCount', { count: 8 }, lang)}</span>
          </div>
        </div>
        <div class="pill-grid">
          <a href={`/${lang}/convert/nanomolar-to-micromolar/`} class="unit-pill pill-emerald">nM ↔ µM</a>
          <a href={`/${lang}/convert/nanomolar-to-micromolar/`} class="unit-pill pill-emerald">pM ↔ nM</a>
          <a href={`/${lang}/convert/nanomolar-to-micromolar/`} class="unit-pill pill-emerald">µM ↔ mM</a>
          <a href={`/${lang}/convert/nanomolar-to-micromolar/`} class="unit-pill pill-emerald">nM ↔ pM</a>
          <a href={`/${lang}/convert/nanomolar-to-micromolar/`} class="unit-pill pill-emerald">pM ↔ µM</a>
          <a href={`/${lang}/convert/nanomolar-to-micromolar/`} class="unit-pill pill-emerald">µM ↔ M</a>
          <a href={`/${lang}/convert/nanomolar-to-micromolar/`} class="unit-pill pill-emerald">M ↔ µM</a>
          <a href={`/${lang}/convert/nanomolar-to-micromolar/`} class="unit-pill pill-emerald">µM ↔ nM</a>
        </div>
      </div>

      <!-- 4. Capacitance -->
      <div class="unit-cat-card card-capacitance">
        <div class="cat-header">
          <div class="cat-icon icon-violet">⚡</div>
          <div>
            <h3 class="cat-title">{t('categories.capacitance', undefined, lang)}</h3>
            <span class="cat-count">{t('categories.conversionsCount', { count: 6 }, lang)}</span>
          </div>
        </div>
        <div class="pill-grid">
          <a href={`/${lang}/convert/nanofarads-to-microfarads/`} class="unit-pill pill-violet">nF ↔ µF</a>
          <a href={`/${lang}/convert/microfarads-to-nanofarads/`} class="unit-pill pill-violet">pF ↔ nF</a>
          <a href={`/${lang}/convert/microfarads-to-nanofarads/`} class="unit-pill pill-violet">µF ↔ mF</a>
          <a href={`/${lang}/convert/nanofarads-to-microfarads/`} class="unit-pill pill-violet">nF ↔ pF</a>
          <a href={`/${lang}/convert/microfarads-to-nanofarads/`} class="unit-pill pill-violet">pF ↔ µF</a>
          <a href={`/${lang}/convert/microfarads-to-nanofarads/`} class="unit-pill pill-violet">µF ↔ F</a>
        </div>
      </div>

      <!-- 5. Time -->
      <div class="unit-cat-card card-time">
        <div class="cat-header">
          <div class="cat-icon icon-rose">⏱️</div>
          <div>
            <h3 class="cat-title">{t('categories.time', undefined, lang)}</h3>
            <span class="cat-count">{t('categories.conversionsCount', { count: 8 }, lang)}</span>
          </div>
        </div>
        <div class="pill-grid">
          <a href={`/${lang}/convert/nanoseconds-to-microseconds/`} class="unit-pill pill-rose">ns ↔ µs</a>
          <a href={`/${lang}/convert/second-to-microsecond/`} class="unit-pill pill-rose">ps ↔ ns</a>
          <a href={`/${lang}/convert/second-to-microsecond/`} class="unit-pill pill-rose">µs ↔ ms</a>
          <a href={`/${lang}/convert/nanoseconds-to-microseconds/`} class="unit-pill pill-rose">ns ↔ ps</a>
          <a href={`/${lang}/convert/second-to-microsecond/`} class="unit-pill pill-rose">ps ↔ µs</a>
          <a href={`/${lang}/convert/second-to-microsecond/`} class="unit-pill pill-rose">µs ↔ s</a>
          <a href={`/${lang}/convert/second-to-microsecond/`} class="unit-pill pill-rose">µs ↔ min</a>
          <a href={`/${lang}/convert/nanoseconds-to-microseconds/`} class="unit-pill pill-rose">µs ↔ ns</a>
        </div>
      </div>

      <!-- 6. Volume -->
      <div class="unit-cat-card card-volume">
        <div class="cat-header">
          <div class="cat-icon icon-indigo">🧊</div>
          <div>
            <h3 class="cat-title">{t('categories.volume', undefined, lang)}</h3>
            <span class="cat-count">{t('categories.conversionsCount', { count: 6 }, lang)}</span>
          </div>
        </div>
        <div class="pill-grid">
          <a href={`/${lang}/convert/nano-to-micro/`} class="unit-pill pill-indigo">nL ↔ µL</a>
          <a href={`/${lang}/convert/nano-to-micro/`} class="unit-pill pill-indigo">pL ↔ nL</a>
          <a href={`/${lang}/convert/micro-to-nano/`} class="unit-pill pill-indigo">µL ↔ mL</a>
          <a href={`/${lang}/convert/nano-to-pico/`} class="unit-pill pill-indigo">nL ↔ pL</a>
          <a href={`/${lang}/convert/pico-to-nano/`} class="unit-pill pill-indigo">pL ↔ µL</a>
          <a href={`/${lang}/convert/micro-to-nano/`} class="unit-pill pill-indigo">µL ↔ L</a>
        </div>
      </div>

      <!-- 7. Electric Current -->
      <div class="unit-cat-card card-current">
        <div class="cat-header">
          <div class="cat-icon icon-yellow">⚡</div>
          <div>
            <h3 class="cat-title">{t('categories.electricCurrent', undefined, lang)}</h3>
            <span class="cat-count">{t('categories.conversionsCount', { count: 8 }, lang)}</span>
          </div>
        </div>
        <div class="pill-grid">
          <a href={`/${lang}/convert/nano-to-micro/`} class="unit-pill pill-yellow">nA ↔ µA</a>
          <a href={`/${lang}/convert/nano-to-micro/`} class="unit-pill pill-yellow">pA ↔ nA</a>
          <a href={`/${lang}/convert/micro-to-nano/`} class="unit-pill pill-yellow">µA ↔ mA</a>
          <a href={`/${lang}/convert/nano-to-pico/`} class="unit-pill pill-yellow">nA ↔ pA</a>
          <a href={`/${lang}/convert/pico-to-nano/`} class="unit-pill pill-yellow">pA ↔ µA</a>
          <a href={`/${lang}/convert/micro-to-nano/`} class="unit-pill pill-yellow">µA ↔ A</a>
          <a href={`/${lang}/conversion-charts/`} class="unit-pill pill-yellow">kA ↔ µA</a>
          <a href={`/${lang}/convert/micro-to-nano/`} class="unit-pill pill-yellow">µA ↔ nA</a>
        </div>
      </div>

      <!-- 8. Electric Charge -->
      <div class="unit-cat-card card-charge">
        <div class="cat-header">
          <div class="cat-icon icon-teal">🔋</div>
          <div>
            <h3 class="cat-title">{t('categories.electricCharge', undefined, lang)}</h3>
            <span class="cat-count">{t('categories.conversionsCount', { count: 6 }, lang)}</span>
          </div>
        </div>
        <div class="pill-grid">
          <a href={`/${lang}/convert/nano-to-micro/`} class="unit-pill pill-teal">nC ↔ µC</a>
          <a href={`/${lang}/convert/nano-to-micro/`} class="unit-pill pill-teal">pC ↔ nC</a>
          <a href={`/${lang}/convert/micro-to-nano/`} class="unit-pill pill-teal">µC ↔ mC</a>
          <a href={`/${lang}/convert/nano-to-pico/`} class="unit-pill pill-teal">nC ↔ pC</a>
          <a href={`/${lang}/convert/pico-to-nano/`} class="unit-pill pill-teal">pC ↔ µC</a>
          <a href={`/${lang}/convert/micro-to-nano/`} class="unit-pill pill-teal">µC ↔ C</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Section 3: The Only Formula You Need -->
  <section id="formula" class="content-section">
    <div class="formula-grid">
      <div class="formula-info">
        <h2>{t('formula.sectionTitle', undefined, lang)}</h2>
        <p>{t('formula.body1', undefined, lang)}</p>

        <div class="formula-box gold-box" dir="ltr">
          <code>{t('formula.microEq', undefined, lang)}</code>
        </div>

        <div class="formula-box blue-box" dir="ltr">
          <code>{t('formula.nanoEq', undefined, lang)}</code>
        </div>

        <p class="muted-note">
          {t('formula.exampleText', undefined, lang)}
        </p>
      </div>

      <div class="table-card">
        <h3 class="table-card-title">{t('formula.quickTableTitle', undefined, lang)}</h3>
        <table class="quick-table" dir="ltr">
          <thead>
            <tr>
              <th>{t('formula.thNano', undefined, lang)}</th>
              <th>{t('formula.thMicro', undefined, lang)}</th>
            </tr>
          </thead>
          <tbody>
            <tr><td>1</td><td class="gold-text">0.001</td></tr>
            <tr><td>5</td><td class="gold-text">0.005</td></tr>
            <tr><td>10</td><td class="gold-text">0.01</td></tr>
            <tr><td>25</td><td class="gold-text">0.025</td></tr>
            <tr><td>50</td><td class="gold-text">0.05</td></tr>
            <tr><td>100</td><td class="gold-text">0.1</td></tr>
            <tr><td>250</td><td class="gold-text">0.25</td></tr>
            <tr><td>500</td><td class="gold-text">0.5</td></tr>
            <tr><td>750</td><td class="gold-text">0.75</td></tr>
            <tr><td>1,000</td><td class="gold-text">1</td></tr>
          </tbody>
        </table>
        <p class="table-footnote">
          {t('formula.footnote', undefined, lang)}
        </p>
      </div>
    </div>
  </section>

  <!-- Section 4: Where Nano and Micro Sit on the SI Ladder -->
  <section id="si-ladder" class="content-section">
    <div class="section-title-wrap">
      <h2>{t('siLadder.sectionTitle', undefined, lang)}</h2>
      <p class="section-subtitle">
        {t('siLadder.sectionSubtitle', undefined, lang)}
      </p>
    </div>

    <div class="si-ladder-wrap" dir="ltr">
      <div class="ladder-pill">
        <span class="l-name">femto</span>
        <span class="l-exp">10⁻¹⁵</span>
      </div>
      <div class="ladder-pill">
        <span class="l-name">pico</span>
        <span class="l-exp">10⁻¹²</span>
      </div>
      <div class="ladder-pill gold-ladder-pill">
        <span class="l-name">NANO</span>
        <span class="l-exp">10⁻⁹</span>
      </div>
      <div class="ladder-pill gold-ladder-pill">
        <span class="l-name">MICRO</span>
        <span class="l-exp">10⁻⁶</span>
      </div>
      <div class="ladder-pill">
        <span class="l-name">milli</span>
        <span class="l-exp">10⁻³</span>
      </div>
      <div class="ladder-pill">
        <span class="l-name">base</span>
        <span class="l-exp">10⁰</span>
      </div>
      <div class="ladder-pill">
        <span class="l-name">kilo</span>
        <span class="l-exp">10³</span>
      </div>
      <div class="ladder-pill">
        <span class="l-name">mega</span>
        <span class="l-exp">10⁶</span>
      </div>
      <div class="ladder-pill">
        <span class="l-name">giga</span>
        <span class="l-exp">10⁹</span>
      </div>
      <div class="ladder-pill">
        <span class="l-name">tera</span>
        <span class="l-exp">10¹²</span>
      </div>
    </div>

    <div style="text-align: center; margin-top: 24px;">
      <a href={`/${lang}/si-prefix-converter/`} class="primary-btn">{t('siLadder.openConverterBtn', undefined, lang)}</a>
    </div>
  </section>

  <!-- Section 5: Visual Scale Illustration (SVG) -->
  <section id="scale-diagram" class="content-section">
    <div class="section-title-wrap">
      <h2>{t('scaleDiagram.sectionTitle', undefined, lang)}</h2>
      <p class="section-subtitle">
        {t('scaleDiagram.sectionSubtitle', undefined, lang)}
      </p>
    </div>

    <div class="scale-svg-container" dir="ltr">
      <svg viewBox="0 0 960 300" class="scale-svg" xmlns="http://www.w3.org/2000/svg" role="img" aria-label={t('scaleDiagram.ariaLabel', undefined, lang)}>
        <defs>
          <linearGradient id={`scaleGrad-${lang}`} x1="0%" y1="0%" x2="100%" y2="0%">
            <stop offset="0%" stop-color="#38bdf8" />
            <stop offset="25%" stop-color="#818cf8" />
            <stop offset="45%" stop-color="#f59e0b" />
            <stop offset="60%" stop-color="#fbbf24" />
            <stop offset="80%" stop-color="#f43f5e" />
            <stop offset="100%" stop-color="#ec4899" />
          </linearGradient>
        </defs>

        <!-- Main Continuum Axis Bar -->
        <rect x="40" y="150" width="880" height="8" rx="4" fill={`url(#scaleGrad-${lang})`} />

        <!-- 1,000x Ratio Boundary Marker (1 um = 1,000 nm) -->
        <line x1="600" y1="100" x2="600" y2="210" stroke="#f59e0b" stroke-width="2" stroke-dasharray="4 4" />
        <rect x="525" y="70" width="150" height="26" rx="13" fill="rgba(245, 158, 11, 0.22)" stroke="#f59e0b" stroke-width="1.5" />
        <text x="600" y="87" text-anchor="middle" fill="#fbbf24" font-size="12" font-weight="800" font-family="system-ui, sans-serif">{t('scaleDiagram.ratioMarker', undefined, lang)}</text>

        <!-- Node 1: 0.1 nm (Water Molecule) -->
        <circle cx="65" cy="154" r="7" fill="#070b12" stroke="#38bdf8" stroke-width="3" />
        <text x="65" y="132" text-anchor="middle" fill="#38bdf8" font-size="13" font-weight="800" font-family="ui-monospace, monospace">0.1 nm</text>
        <text x="65" y="185" text-anchor="middle" fill="#f8fafc" font-size="12" font-weight="700" font-family="system-ui, sans-serif">{t('scaleDiagram.waterMolecule', undefined, lang)}</text>
        <text x="65" y="202" text-anchor="middle" fill="#cbd5e1" font-size="11" font-family="system-ui, sans-serif">{t('scaleDiagram.waterMoleculeSub', undefined, lang)}</text>

        <!-- Node 2: 2 nm (Transistor Gate Oxide) -->
        <circle cx="175" cy="154" r="7" fill="#070b12" stroke="#38bdf8" stroke-width="3" />
        <text x="175" y="132" text-anchor="middle" fill="#38bdf8" font-size="13" font-weight="800" font-family="ui-monospace, monospace">2–3 nm</text>
        <text x="175" y="185" text-anchor="middle" fill="#f8fafc" font-size="12" font-weight="700" font-family="system-ui, sans-serif">{t('scaleDiagram.transistorGate', undefined, lang)}</text>
        <text x="175" y="202" text-anchor="middle" fill="#cbd5e1" font-size="11" font-family="system-ui, sans-serif">{t('scaleDiagram.transistorGateSub', undefined, lang)}</text>

        <!-- Node 3: 10 nm (DNA Double Helix) -->
        <circle cx="285" cy="154" r="7" fill="#070b12" stroke="#818cf8" stroke-width="3" />
        <text x="285" y="132" text-anchor="middle" fill="#818cf8" font-size="13" font-weight="800" font-family="ui-monospace, monospace">10 nm</text>
        <text x="285" y="185" text-anchor="middle" fill="#f8fafc" font-size="12" font-weight="700" font-family="system-ui, sans-serif">{t('scaleDiagram.dnaHelix', undefined, lang)}</text>
        <text x="285" y="202" text-anchor="middle" fill="#cbd5e1" font-size="11" font-family="system-ui, sans-serif">{t('scaleDiagram.dnaHelixSub', undefined, lang)}</text>

        <!-- Node 4: 100 nm (Viruses & Macromolecules) -->
        <circle cx="395" cy="154" r="7" fill="#070b12" stroke="#f59e0b" stroke-width="3" />
        <text x="395" y="132" text-anchor="middle" fill="#fbbf24" font-size="13" font-weight="800" font-family="ui-monospace, monospace">100 nm</text>
        <text x="395" y="185" text-anchor="middle" fill="#f8fafc" font-size="12" font-weight="700" font-family="system-ui, sans-serif">{t('scaleDiagram.viruses', undefined, lang)}</text>
        <text x="395" y="202" text-anchor="middle" fill="#cbd5e1" font-size="11" font-family="system-ui, sans-serif">{t('scaleDiagram.virusesSub', undefined, lang)}</text>

        <!-- Node 5: 500 nm (Visible Light Spectrum) -->
