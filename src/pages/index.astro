          <a href="/convert/nanomolar-to-micromolar/" class="unit-pill pill-emerald">nM ↔ µM</a>
          <a href="/convert/nanomolar-to-micromolar/" class="unit-pill pill-emerald">pM ↔ nM</a>
          <a href="/convert/nanomolar-to-micromolar/" class="unit-pill pill-emerald">µM ↔ mM</a>
          <a href="/convert/nanomolar-to-micromolar/" class="unit-pill pill-emerald">nM ↔ pM</a>
          <a href="/convert/nanomolar-to-micromolar/" class="unit-pill pill-emerald">pM ↔ µM</a>
          <a href="/convert/nanomolar-to-micromolar/" class="unit-pill pill-emerald">µM ↔ M</a>
          <a href="/convert/nanomolar-to-micromolar/" class="unit-pill pill-emerald">M ↔ µM</a>
          <a href="/convert/nanomolar-to-micromolar/" class="unit-pill pill-emerald">µM ↔ nM</a>
        </div>
      </div>

      <!-- 4. Capacitance (Violet) -->
      <div class="unit-cat-card card-capacitance">
        <div class="cat-header">
          <div class="cat-icon icon-violet">⚡</div>
          <div>
            <h3 class="cat-title">Capacitance</h3>
            <span class="cat-count">6 Conversions</span>
