          <a href="/convert/gram-to-microgram/" class="unit-pill pill-amber">kg ↔ µg</a>
          <a href="/convert/micrograms-to-nanograms/" class="unit-pill pill-amber">µg ↔ ng</a>
        </div>
      </div>

      <!-- 3. Concentration (Emerald) -->
      <div class="unit-cat-card card-concentration">
