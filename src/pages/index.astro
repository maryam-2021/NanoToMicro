---
import Base from '../layouts/Base.astro';
import ConverterIsland from '../components/ConverterIsland.svelte';

const homeFaqs = [
  {
    q: 'How do you convert nano to micro?',
    a: 'To convert from nano to micro, divide the value by 1,000 (or multiply by 0.001). For example: 2,500 nanometers ÷ 1,000 = 2.5 micrometers.'
  },
  {
    q: 'How do you convert micro to nano?',
    a: 'To convert from micro to nano, multiply the value by 1,000. For example: 0.75 micrograms × 1,000 = 750 nanograms.'
  },
  {
    q: 'What is the difference between a nanometer and a micrometer?',
    a: 'A nanometer (nm) is 10⁻⁹ meters (one billionth of a meter), while a micrometer (µm, or micron) is 10⁻⁶ meters (one millionth of a meter). One micrometer contains exactly 1,000 nanometers.'
  },
  {
    q: 'Why is 1 micro equal to 1,000 nano?',
    a: 'In the International System of Units (SI), metric prefixes follow powers of ten in steps of 10³. Micro is 10⁻⁶ and nano is 10⁻⁹. The mathematical ratio between 10⁻⁶ and 10⁻⁹ is 10³ = 1,000.'
  },
  {
    q: 'Which is bigger: nano or micro?',
    a: 'Micro is 1,000 times larger than nano. An object measuring 1 micrometer is 1,000 times larger than an object measuring 1 nanometer.'
  },
  {
    q: 'Where are nano and micro units used in real life?',
    a: 'Nanometers (nm) measure semiconductor transistors, DNA helix widths (2.5 nm), and light wavelengths. Micrometers (µm) measure biological cells (10–30 µm), human hair diameter (70 µm), and optical fibers.'
  },
  {
    q: 'How does nano-to-micro metrology apply to antigravity research?',
    a: 'Precision testing of hypothetical gravitational anomalies, Casimir cavity forces, and propellantless thrust requires micro-Newton (µN) and nano-Newton (nN) laser interferometry and torsion balances to rule out thermal expansion and air currents.'
  }
];

const webAppSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Nano to Micro Converter',
  url: 'https://nanotomicro.com/',
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'All',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD'
  },
  description: 'The definitive reference for all nano ↔ micro conversions, SI metric calculators, and evidence-based physics research.'
};

const title = 'Nano to Micro Converter: Instant n ↔ µ Metric Conversions | NanoToMicro';
const description = 'The definitive reference for all nano ↔ micro conversions. Instant calculations, exact formulas, tables, and evidence-based antigravity physics explainers.';
---

<Base
  title={title}
  description={description}
  canonicalPath="/"
  jsonLd={[webAppSchema]}
  faqs={homeFaqs}
>
  <!-- Slim Sticky Jump Navigation Bar -->
  <div class="sticky-nav-wrapper">
    <nav class="sticky-nav-bar" aria-label="Quick jump section navigation">
      <a href="#converters" class="nav-chip">Converters</a>
      <span class="nav-sep">·</span>
      <a href="#formula" class="nav-chip">Formula</a>
      <span class="nav-sep">·</span>
      <a href="#si-ladder" class="nav-chip">SI Ladder</a>
      <span class="nav-sep">·</span>
      <a href="#scale-diagram" class="nav-chip">Scale</a>
      <span class="nav-sep">·</span>
      <a href="#antigravity" class="nav-chip">Antigravity</a>
      <span class="nav-sep">·</span>
      <a href="#faq" class="nav-chip">FAQ</a>
    </nav>
  </div>

  <!-- Hero Section -->
  <section class="hero-container">
    <div class="hero-badge">
      <span class="pulse-dot"></span>
      <span>1 Nano = 0.001 Micro (Exact SI Metric Ratio)</span>
    </div>

    <h1 class="main-title">
      Nano to Micro <span class="gold-gradient">Converter</span>
    </h1>

    <p class="hero-desc">
      The definitive reference for all nano ↔ micro conversions. Instant calculations, exact formulas,
      and print-ready conversion tables for length, mass, concentration, capacitance, time, volume, current, and charge.
    </p>

    <!-- Svelte Reactive Interactive Calculator -->
    <div class="calc-wrapper">
      <ConverterIsland
        client:load
        fromSymbol="nm"
        toSymbol="µm"
        fromName="nanometer"
        toName="micrometer"
        factor={0.001}
        exampleInput={2500}
      />
    </div>
  </section>

    <!-- Authority Internal Hub Navigation Callouts -->
    <div class="hub-callouts-banner" style="background: rgba(19, 28, 46, 0.8); border: 1px solid rgba(245, 158, 11, 0.25); border-radius: 14px; padding: 20px 24px; margin: 28px 0; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px;">
      <div style="font-size: 14px; color: #cbd5e1;">
        🚀 Explore our comprehensive <a href="/physics/" style="color: #38bdf8; font-weight: 700; text-decoration: none;">Physics Research Hub</a> · 
        ⚡ Try our <a href="/converters/" style="color: #fbbf24; font-weight: 700; text-decoration: none;">specialized converters</a> for length, mass, and more · 
        📏 Learn more about <a href="/guides/si-prefixes-guide.html" style="color: #34d399; font-weight: 700; text-decoration: none;">SI prefixes</a> in our detailed guide.
      </div>
      <div>
        <a href="/physics/metrology-checklist.html" style="color: #94a3b8; font-size: 12px; font-weight: 600; text-decoration: none;">
