          <div>
            <h3 class="cat-title">Volume</h3>
            <span class="cat-count">6 Conversions</span>
          </div>
        </div>
        <div class="pill-grid">
          <a href="/convert/nano-to-micro/" class="unit-pill pill-indigo">nL ↔ µL</a>
          <a href="/convert/nano-to-micro/" class="unit-pill pill-indigo">pL ↔ nL</a>
          <a href="/convert/micro-to-nano/" class="unit-pill pill-indigo">µL ↔ mL</a>
          <a href="/convert/nano-to-pico/" class="unit-pill pill-indigo">nL ↔ pL</a>
          <a href="/convert/pico-to-nano/" class="unit-pill pill-indigo">pL ↔ µL</a>
          <a href="/convert/micro-to-nano/" class="unit-pill pill-indigo">µL ↔ L</a>
        </div>
      </div>

      <!-- 7. Electric Current (Yellow) -->
      <div class="unit-cat-card card-current">
        <div class="cat-header">
          <div class="cat-icon icon-yellow">⚡</div>
          <div>
            <h3 class="cat-title">Electric Current</h3>
            <span class="cat-count">8 Conversions</span>
          </div>
        </div>
        <div class="pill-grid">
          <a href="/convert/nano-to-micro/" class="unit-pill pill-yellow">nA ↔ µA</a>
          <a href="/convert/nano-to-micro/" class="unit-pill pill-yellow">pA ↔ nA</a>
