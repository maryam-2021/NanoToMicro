---
import Base from '../layouts/Base.astro';
import { CONVERTERS } from '../data/converters';

const chartValues = [1, 2, 5, 10, 25, 50, 100, 250, 500, 1000];
const forwardConverters = CONVERTERS.filter(c => c.factor < 1);
---

<Base
  title="Nano to Micro Conversion Charts & Quick Printable Tables | NanoToMicro"
  description="Printable reference conversion tables for nanometers to micrometers, nanograms to micrograms, nanomolar to micromolar, nanofarads to microfarads."
  canonicalPath="/conversion-charts"
>
  <div class="charts-header">
    <div class="pill">Printable Reference</div>
    <h1 class="title">Nano to Micro Conversion Charts</h1>
    <p class="subtitle">
      Quick-reference lookup matrices for high-frequency scientific and laboratory calculations.
    </p>
  </div>

  <div class="charts-grid">
    {forwardConverters.map((conv) => (
      <div class="chart-card">
        <div class="card-header">
          <div class="badge">{conv.category}</div>
          <h2 class="chart-title">
            <a href={`/convert/${conv.slug}/`}>{conv.fromName} to {conv.toName}</a>
          </h2>
          <div class="sub-formula">1 {conv.fromSymbol} = {conv.factor} {conv.toSymbol}</div>
        </div>

        <table class="chart-table">
          <thead>
            <tr>
              <th>{conv.fromSymbol}</th>
              <th>{conv.toSymbol}</th>
              <th>Scientific Notation</th>
            </tr>
          </thead>
          <tbody>
            {chartValues.map((v) => {
              const res = v * conv.factor;
              return (
                <tr>
                  <td><strong>{v.toLocaleString()}</strong></td>
                  <td class="res-td">{res.toLocaleString(undefined, { maximumFractionDigits: 6 })}</td>
                  <td><code>{res.toExponential(2)}</code></td>
                </tr>
              );
            })}
          </tbody>
        </table>

        <div class="card-footer">
          <a href={`/convert/${conv.slug}/`} class="full-calc-link">
            Open Interactive Calculator & Formula →
          </a>
        </div>
      </div>
    ))}
  </div>
</Base>

<style>
  .charts-header {
    text-align: center;
    padding: 2rem 0;
    max-width: 800px;
    margin: 0 auto;
  }

  .pill {
    display: inline-block;
    background: rgba(56, 189, 248, 0.1);
    color: var(--primary);
    border: 1px solid rgba(56, 189, 248, 0.3);
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: #ffffff;
    letter-spacing: -0.02em;
    margin-bottom: 0.75rem;
  }

  .subtitle {
    color: var(--text-muted);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .charts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
    gap: 1.5rem;
    margin: 2rem 0;
  }

  .chart-card {
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 0.75rem;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .card-header {
    padding: 1.25rem;
    background: rgba(15, 23, 42, 0.6);
    border-bottom: 1px solid var(--border-color);
  }

  .badge {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--purple-accent);
    margin-bottom: 0.375rem;
  }

  .chart-title {
    font-size: 1.125rem;
    font-weight: 700;
  }

  .chart-title a {
    color: #ffffff;
  }

  .chart-title a:hover {
    color: var(--primary);
  }

  .sub-formula {
    font-size: 0.8125rem;
    color: #64748b;
    font-family: ui-monospace, monospace;
    margin-top: 0.25rem;
  }

  .chart-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.8125rem;
    text-align: left;
  }

  .chart-table th,
  .chart-table td {
    padding: 0.5rem 1rem;
    border-bottom: 1px solid rgba(51, 65, 85, 0.4);
  }

  .chart-table th {
    background: #090e1a;
    color: #94a3b8;
    font-weight: 600;
    font-size: 0.6875rem;
    text-transform: uppercase;
  }

  .res-td {
    color: var(--primary);
    font-weight: 600;
  }

  .chart-table code {
    background: #1e293b;
    padding: 0.1rem 0.3rem;
    border-radius: 0.2rem;
    color: #cbd5e1;
    font-size: 0.75rem;
  }

  .card-footer {
    padding: 0.875rem 1rem;
    background: #090e1a;
    margin-top: auto;
    border-top: 1px solid var(--border-color);
  }

  .full-calc-link {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--primary);
  }
</style>
