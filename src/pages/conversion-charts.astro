---
// src/pages/conversion-charts.astro
import Base from '../layouts/Base.astro';
import { t } from '../i18n/utils';

const lang = 'en';
const pageTitle = t('chartsPage.title', undefined, lang);
const pageSubtitle = t('chartsPage.subtitle', undefined, lang);
const pageBadge = t('chartsPage.badge', undefined, lang);

const chartData = [
  { nm: 1, um: '0.001', mm: '0.000001', pm: '1,000' },
  { nm: 5, um: '0.005', mm: '0.000005', pm: '5,000' },
  { nm: 10, um: '0.01', mm: '0.00001', pm: '10,000' },
  { nm: 25, um: '0.025', mm: '0.000025', pm: '25,000' },
  { nm: 50, um: '0.05', mm: '0.00005', pm: '50,000' },
  { nm: 100, um: '0.1', mm: '0.0001', pm: '100,000' },
  { nm: 250, um: '0.25', mm: '0.00025', pm: '250,000' },
  { nm: 500, um: '0.5', mm: '0.0005', pm: '500,000' },
  { nm: 750, um: '0.75', mm: '0.00075', pm: '750,000' },
  { nm: 1000, um: '1.0', mm: '0.001', pm: '1,000,000' },
  { nm: 2500, um: '2.5', mm: '0.0025', pm: '2,500,000' },
  { nm: 5000, um: '5.0', mm: '0.005', pm: '5,000,000' },
  { nm: 10000, um: '10.0', mm: '0.01', pm: '10,000,000' },
];
---

<Base
  title={`${pageTitle} | NanoToMicro`}
  description={pageSubtitle}
  canonicalPath="/conversion-charts/"
  lang={lang}
>
  <div class="page-head">
    <div class="pill">{pageBadge}</div>
    <h1 class="title">{pageTitle}</h1>
    <p class="subtitle">
      {pageSubtitle}
    </p>
  </div>

  <div class="table-card">
    <table class="chart-table">
      <thead>
        <tr>
          <th>{t('units.nanometers', undefined, lang)} (<span dir="ltr">nm</span>)</th>
          <th>{t('units.micrometers', undefined, lang)} (<span dir="ltr">µm</span>)</th>
          <th>{t('units.millimeters', undefined, lang)} (<span dir="ltr">mm</span>)</th>
          <th>{t('units.picometers', undefined, lang)} (<span dir="ltr">pm</span>)</th>
        </tr>
      </thead>
      <tbody>
        {chartData.map((row) => (
          <tr>
            <td style="font-weight: 700;"><bdi dir="ltr">{row.nm.toLocaleString('en')} nm</bdi></td>
            <td style="color: #fbbf24; font-weight: 800;"><bdi dir="ltr">{row.um} µm</bdi></td>
            <td style="color: #38bdf8;"><bdi dir="ltr">{row.mm} mm</bdi></td>
            <td style="color: #cbd5e1;"><bdi dir="ltr">{row.pm} pm</bdi></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</Base>

<style>
  .page-head {
    text-align: center;
    max-width: 800px;
    margin: 20px auto 40px;
  }
  .pill {
    display: inline-block;
    background: rgba(245, 158, 11, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(245, 158, 11, 0.35);
    padding: 4px 12px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .title {
    font-size: 36px;
    font-weight: 900;
    color: #ffffff;
    margin: 0 0 12px;
  }
  .subtitle {
    font-size: 16px;
    color: #cbd5e1;
    line-height: 1.6;
  }
  .table-card {
    background: #0f1623;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    overflow-x: auto;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
  }
  .chart-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
  }
  .chart-table th {
    background: #192338;
    padding: 16px 20px;
    font-weight: 800;
    color: #f8fafc;
    border-bottom: 2px solid rgba(255, 255, 255, 0.1);
  }
  .chart-table td {
    padding: 14px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-family: ui-monospace, monospace;
  }
</style>
